# PostgreSQL. Production: Neon — pooled URL for the app, direct URL for migrations.
# Local alternative: `npm run db:up` (docker-compose) and use
#   postgresql://rydge:rydge@localhost:5433/rydge for both.
DATABASE_URL=""
DIRECT_URL=""

AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Operator account: used by `npm run admin:create` (and optionally the seed).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# S3-compatible object storage for uploads (Neon storage, AWS S3, R2, MinIO…).
# Leave all blank to write uploads to local disk (storage/, UPLOAD_DIR).
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET="media"

# Stripe one-time price. Keep all three private; never NEXT_PUBLIC_.
# Sandbox only for now: use sk_test_ keys, a test-mode Price ID and the
# test-mode webhook signing secret. Live keys are refused unless
# STRIPE_LIVE_MODE="enabled".
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_LIVE_MODE=""

# Local-disk fallback for customer uploads when object storage is not set.
UPLOAD_DIR=""
