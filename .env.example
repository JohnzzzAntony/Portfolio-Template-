# PostgreSQL. Production: Neon — pooled URL for the app, direct URL for migrations.
# Local alternative: `npm run db:up` (docker-compose) and use
#   postgresql://rydge:rydge@localhost:5433/rydge for both.
DATABASE_URL=""
DIRECT_URL=""

AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Operator account: used by `npm run admin:create` (and optionally the seed).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# S3-compatible object storage for uploads (Neon storage, AWS S3, R2, MinIO…).
# Leave all blank to write uploads to local disk (storage/media).
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET="media"
