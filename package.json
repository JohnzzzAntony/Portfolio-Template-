{
  "name": "forma-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:generate && npm run db:deploy && npm run db:seed && npm run assets:generate",
    "assets:generate": "node scripts/generate-placeholders.mjs",
    "check": "npm run lint && npm run typecheck && npm run build",
    "db:deploy": "prisma migrate deploy",
    "prestart": "node scripts/check-env.mjs",
    "test": "node --experimental-strip-types --test scripts/platform-policy.test.mjs",
    "test:integration": "node --experimental-strip-types scripts/platform-smoke.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "jose": "^5.9.6",
    "lenis": "^1.1.18",
    "next": "^16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "prisma": "^6.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
